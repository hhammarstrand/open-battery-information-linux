# This is a Linux fork: text files are stored with LF.
#
# CRLF in a Python file with a shebang makes it unrunnable on Linux
# ("bad interpreter: /usr/bin/env python3^M"), and CRLF in a shell script or
# a udev rule breaks it outright, so the endings are pinned here rather than
# left to whatever each contributor's editor does.

* text=auto eol=lf

*.py     text eol=lf
*.sh     text eol=lf
*.spec   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.rules  text eol=lf
*.service text eol=lf
*.desktop text eol=lf
Makefile text eol=lf

# Vendored Arduino library and firmware: left exactly as upstream has it.
ArduinoOBI/lib/** -text
ArduinoOBI/src/** -text

*.png binary
*.icns binary
